{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "grove": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Grove gateway",
      "options": {
        "baseURL": "{env:GROVE_GATEWAY_URL}",
        "apiKey": "{env:GROVE_RUN_TOKEN}"
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Muse Spark 1.3",
          "tool_call": true,
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    }
  },
  "model": "grove/muse-spark-1.3",
  "small_model": "grove/muse-spark-1.3",
  "default_agent": "grove",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "instructions": [],
  "plugin": [],
  "mcp": {},
  "lsp": false,
  "formatter": false,
  "permission": {
    "*": "deny",
    "bash": { "*": "deny", "brain *": "allow" },
    "edit": "deny",
    "webfetch": "deny"
  }
}
