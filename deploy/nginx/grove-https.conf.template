# The public host: TLS here, everything else in the API on 127.0.0.1:8000. No rule looks at the
# user agent, so Meta's metadata fetcher (meta-webindexer/1.1) gets the same answers as anyone.
# Every TLS setting is in this file: a box gets only the certificate from certbot, and ECDHE
# ciphers need no dhparam file.

# Each address may ask for a sign-in code at a steady rate, on top of the API's own limits per
# mail address. A code costs a mail, so this stops a flood before it reaches the API.
limit_req_zone $binary_remote_addr zone=grove_email:1m rate=10r/m;
# The OAuth paths that a host calls with no session: each address registers clients and asks for
# tokens at a steady rate, on top of the API's own cap on registrations across the server.
limit_req_zone $binary_remote_addr zone=grove_oauth:1m rate=30r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __GROVE_HOST__;

    ssl_certificate /etc/letsencrypt/live/__GROVE_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__GROVE_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:grove_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    # nginx writes a body to disk before the API sees it, so no path takes a large one. An upload
    # route adds its own location, with its limit and proxy_request_buffering off, when it exists.
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # MCP over streamable HTTP may answer with a stream.
    proxy_buffering off;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8000;
    }

    location /v1/auth/email/ {
        limit_req zone=grove_email burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /register {
        limit_req zone=grove_oauth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }

    location = /token {
        limit_req zone=grove_oauth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }
}
