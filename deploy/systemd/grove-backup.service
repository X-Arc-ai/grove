[Unit]
Description=Grove daily offline dump of the store, then a restore check
Requires=docker.service
After=docker.service
# A failed or killed run hands over to the unit that keeps trying until the services run.
OnFailure=grove-services.service

[Service]
Type=oneshot
ExecStart=/opt/grove/src/deploy/backup.sh
# Runs after every run, also after a KILL that skipped the script's own restart.
ExecStopPost=/opt/grove/src/deploy/services-up.sh
TimeoutStartSec=1h
# services-up.sh may wait for the lock, then for the store and the API.
TimeoutStopSec=30min
