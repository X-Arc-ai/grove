[Unit]
Description=Start the Grove store and its writers at boot, when a backup left them stopped
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/grove/src/deploy/services-up.sh
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
