// Inactive Learner schema only. No application, backfill, or runtime activation.
CREATE CONSTRAINT learner_work_id_unique IF NOT EXISTS FOR (n:LearnerWork) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_work_world_id_episode_id_generation_profile_unique IF NOT EXISTS FOR (n:LearnerWork) REQUIRE (n.world_id, n.episode_id, n.generation, n.profile) IS UNIQUE;
CREATE CONSTRAINT learner_work_world_id_request_id_unique IF NOT EXISTS FOR (n:LearnerWork) REQUIRE (n.world_id, n.request_id) IS UNIQUE;
CREATE INDEX learner_work_world_id_state_retry_at_idx IF NOT EXISTS FOR (n:LearnerWork) ON (n.world_id, n.state, n.retry_at);
CREATE INDEX learner_work_world_id_source_id_idx IF NOT EXISTS FOR (n:LearnerWork) ON (n.world_id, n.source_id);
CREATE INDEX learner_work_world_id_connector_id_idx IF NOT EXISTS FOR (n:LearnerWork) ON (n.world_id, n.connector_id);
CREATE CONSTRAINT learner_executions_id_unique IF NOT EXISTS FOR (n:LearnerExecution) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_executions_world_id_work_id_ordinal_unique IF NOT EXISTS FOR (n:LearnerExecution) REQUIRE (n.world_id, n.work_id, n.ordinal) IS UNIQUE;
CREATE CONSTRAINT learner_executions_world_id_work_id_event_id_unique IF NOT EXISTS FOR (n:LearnerExecution) REQUIRE (n.world_id, n.work_id, n.event_id) IS UNIQUE;
CREATE INDEX learner_executions_world_id_work_id_idx IF NOT EXISTS FOR (n:LearnerExecution) ON (n.world_id, n.work_id);
CREATE INDEX learner_executions_world_id_run_id_idx IF NOT EXISTS FOR (n:LearnerExecution) ON (n.world_id, n.run_id);
CREATE INDEX learner_executions_world_id_commit_id_idx IF NOT EXISTS FOR (n:LearnerExecution) ON (n.world_id, n.commit_id);
CREATE CONSTRAINT learner_calls_id_unique IF NOT EXISTS FOR (n:LearnerCall) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_calls_world_id_work_id_ordinal_unique IF NOT EXISTS FOR (n:LearnerCall) REQUIRE (n.world_id, n.work_id, n.ordinal) IS UNIQUE;
CREATE CONSTRAINT learner_calls_world_id_model_call_id_unique IF NOT EXISTS FOR (n:LearnerCall) REQUIRE (n.world_id, n.model_call_id) IS UNIQUE;
CREATE INDEX learner_calls_world_id_work_id_idx IF NOT EXISTS FOR (n:LearnerCall) ON (n.world_id, n.work_id);
CREATE INDEX learner_calls_world_id_state_idx IF NOT EXISTS FOR (n:LearnerCall) ON (n.world_id, n.state);
CREATE INDEX learner_calls_world_id_run_id_idx IF NOT EXISTS FOR (n:LearnerCall) ON (n.world_id, n.run_id);
CREATE CONSTRAINT learner_dispositions_id_unique IF NOT EXISTS FOR (n:LearnerDisposition) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_dispositions_world_id_work_id_binding_revision_message_ordinal_unique IF NOT EXISTS FOR (n:LearnerDisposition) REQUIRE (n.world_id, n.work_id, n.binding_revision, n.message_ordinal) IS UNIQUE;
CREATE INDEX learner_dispositions_world_id_source_id_idx IF NOT EXISTS FOR (n:LearnerDisposition) ON (n.world_id, n.source_id);
CREATE INDEX learner_dispositions_world_id_episode_id_idx IF NOT EXISTS FOR (n:LearnerDisposition) ON (n.world_id, n.episode_id);
CREATE INDEX learner_dispositions_world_id_state_idx IF NOT EXISTS FOR (n:LearnerDisposition) ON (n.world_id, n.state);
CREATE CONSTRAINT learner_completions_id_unique IF NOT EXISTS FOR (n:LearnerCompletion) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_completions_world_id_work_id_unique IF NOT EXISTS FOR (n:LearnerCompletion) REQUIRE (n.world_id, n.work_id) IS UNIQUE;
CREATE CONSTRAINT learner_completions_world_id_request_id_unique IF NOT EXISTS FOR (n:LearnerCompletion) REQUIRE (n.world_id, n.request_id) IS UNIQUE;
CREATE INDEX learner_completions_world_id_completed_at_idx IF NOT EXISTS FOR (n:LearnerCompletion) ON (n.world_id, n.completed_at);
CREATE INDEX learner_completions_world_id_commit_id_idx IF NOT EXISTS FOR (n:LearnerCompletion) ON (n.world_id, n.commit_id);
CREATE CONSTRAINT learner_episode_progress_id_unique IF NOT EXISTS FOR (n:LearnerEpisodeProgress) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_episode_progress_world_id_episode_id_profile_unique IF NOT EXISTS FOR (n:LearnerEpisodeProgress) REQUIRE (n.world_id, n.episode_id, n.profile) IS UNIQUE;
CREATE CONSTRAINT learner_episode_progress_world_id_stream_anchor_source_id_profile_position_unique IF NOT EXISTS FOR (n:LearnerEpisodeProgress) REQUIRE (n.world_id, n.stream_anchor_source_id, n.profile, n.position) IS UNIQUE;
CREATE INDEX learner_episode_progress_world_id_connector_id_idx IF NOT EXISTS FOR (n:LearnerEpisodeProgress) ON (n.world_id, n.connector_id);
CREATE INDEX learner_episode_progress_world_id_required_work_id_idx IF NOT EXISTS FOR (n:LearnerEpisodeProgress) ON (n.world_id, n.required_work_id);
CREATE CONSTRAINT learner_handoffs_id_unique IF NOT EXISTS FOR (n:LearnerHandoff) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT learner_handoffs_world_id_execution_id_kind_unique IF NOT EXISTS FOR (n:LearnerHandoff) REQUIRE (n.world_id, n.execution_id, n.kind) IS UNIQUE;
CREATE INDEX learner_handoffs_world_id_state_idx IF NOT EXISTS FOR (n:LearnerHandoff) ON (n.world_id, n.state);
CREATE INDEX learner_handoffs_world_id_work_id_idx IF NOT EXISTS FOR (n:LearnerHandoff) ON (n.world_id, n.work_id);
CREATE INDEX requests_world_id_learner_work_id_idx IF NOT EXISTS FOR (n:Request) ON (n.world_id, n.learner_work_id);
CREATE INDEX requests_world_id_learner_completion_id_idx IF NOT EXISTS FOR (n:Request) ON (n.world_id, n.learner_completion_id);
